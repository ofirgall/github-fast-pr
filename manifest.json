{
  "manifest_version": 3,
  "name": "Fast PR",
  "version": "0.1.0",
  "description": "Group files in GitHub pull requests using a per-repo config.",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["data-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
